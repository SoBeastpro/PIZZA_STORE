@app.route('/api/payment/init', methods=['POST'])
def init_payment():
    try:
        data = request.json
        order_id = str(data.get('order_id'))
        amount = int(data.get('amount'))

        logger.info(f"💰 Инициализация платежа")
        logger.info(f"   OrderId: {order_id}")
        logger.info(f"   Amount: {amount} коп. ({amount / 100} руб.)")

        if not order_id or not amount:
            return jsonify({'success': False, 'error': 'order_id и amount обязательны'}), 400

        if amount < 10000:
            amount = 10000
            logger.info(f"   Сумма скорректирована до {amount} коп. (100 руб.)")

        host = "https://pizzasich.online"

        # ===== ПОЛУЧАЕМ ДАННЫЕ ЗАКАЗА ИЗ ЗАПРОСА =====
        order_data = data.get('order_data')

        # Если order_data не передан, создаём из данных запроса
        if not order_data:
            order_data = {
                'id': int(order_id),
                'customer': {
                    'name': data.get('customer_name', 'Клиент'),
                    'phone': data.get('customer_phone', ''),
                    'address': data.get('customer_address', ''),
                    'comment': data.get('customer_comment', '')
                },
                'items': data.get('items', []),
                'total': data.get('total', amount / 100),
                'payment': data.get('payment', 'online'),
                'source': data.get('source', 'website')
            }
            logger.warning(f"⚠️ order_data не передан, создан из data")

        logger.info(f"📦 Данные заказа для сохранения:")
        logger.info(f"   ID: {order_data.get('id')}")
        logger.info(f"   Сумма: {order_data.get('total')}")
        logger.info(f"   Клиент: {order_data.get('customer', {}).get('name')}")

        params = {
            "TerminalKey": TBANK_TERMINAL_KEY,
            "Amount": amount,
            "OrderId": order_id,
            "Description": f"Заказ в Пиццерии Сичных",
            "PayType": "O",
            "Language": "ru",
            "NotificationURL": f"{host}/api/payment/callback",
            "SuccessURL": f"{host}/success.html",
            "FailURL": f"{host}/fail.html",
            "DATA": {
                "Email": "client@test.ru",
                "Phone": "+79895483577"
            }
        }

        params["Token"] = generate_token(params)

        logger.info("=" * 70)
        logger.info("📤 ПОЛНЫЙ JSON ЗАПРОС К Т-БАНК (Init):")
        logger.info(json.dumps(params, ensure_ascii=False, indent=2))
        logger.info("=" * 70)

        response = requests.post(
            f"{TBANK_API_URL}Init",
            json=params,
            timeout=60,
            headers={'Content-Type': 'application/json'}
        )

        logger.info(f"📥 Статус HTTP: {response.status_code}")
        logger.info(f"📥 Ответ: {response.text}")

        if not response.text:
            return jsonify({'success': False, 'error': 'Пустой ответ'}), 500

        try:
            result = response.json()
        except json.JSONDecodeError:
            return jsonify({
                'success': False,
                'error': f'Невалидный JSON: {response.text[:100]}'
            }), 500

        if result.get('Success'):
            payment_id = result.get('PaymentId')
            payment_url = result.get('PaymentURL')

            # Сохраняем платёж с данными заказа
            payments[int(order_id)] = {
                'payment_id': payment_id,
                'status': 'NEW',
                'amount': amount,
                'created_at': datetime.now().isoformat(),
                'order_data': order_data
            }

            logger.info(f"✅ Платёж создан! PaymentId: {payment_id}")
            logger.info(f"🔗 Ссылка: {payment_url}")
            logger.info(f"📦 Данные заказа сохранены для создания после оплаты")

            return jsonify({
                'success': True,
                'payment_id': payment_id,
                'payment_url': payment_url
            })
        else:
            error_msg = result.get('Message', 'Неизвестная ошибка')
            error_details = result.get('Details', '')
            error_code = result.get('ErrorCode', '')

            logger.error(f"❌ Ошибка: Code={error_code}, Msg={error_msg}, Details={error_details}")

            return jsonify({
                'success': False,
                'error': f"{error_msg}: {error_details}" if error_details else error_msg
            }), 400

    except Exception as e:
        logger.error(f"❌ Ошибка: {e}")
        import traceback
        traceback.print_exc()
        return jsonify({'success': False, 'error': str(e)}), 500


@app.route('/api/payment/status/<int:order_id>', methods=['GET'])
def check_payment(order_id):
    payment = payments.get(order_id)
    if not payment:
        return jsonify({'status': 'not_found'})

    try:
        params = {
            "TerminalKey": TBANK_TERMINAL_KEY,
            "PaymentId": payment['payment_id']
        }
        params["Token"] = generate_token(params)

        response = requests.post(
            f"{TBANK_API_URL}GetState",
            json=params,
            timeout=30
        )

        if not response.text:
            return jsonify({'status': 'error', 'message': 'Пустой ответ'})

        try:
            result = response.json()
        except json.JSONDecodeError:
            return jsonify({'status': 'error', 'message': 'Невалидный JSON'})

        if result.get('Success'):
            status = result.get('Status', 'unknown')
            payments[order_id]['status'] = status

            logger.info(f"📊 Статус платежа #{order_id}: {status}")

            if status == 'CONFIRMED':
                existing_order = next((o for o in orders if o['id'] == order_id), None)

                if not existing_order and payment.get('order_data'):
                    order_data = payment['order_data']
                    order_data['created_at'] = datetime.now().isoformat()
                    order_data['status'] = 'accepted'
                    order_data['payment_status'] = 'paid'

                    orders.append(order_data)
                    save_orders(orders)

                    logger.info(f"✅ ЗАКАЗ #{order_id} СОЗДАН после успешной оплаты!")

                    # ===== ОТПРАВКА В TELEGRAM =====
                    send_telegram_order(order_data)

                    socketio.emit('order_status_update', {
                        'order_id': order_id,
                        'status': 'accepted'
                    })

                    return jsonify({
                        'status': status,
                        'order_created': True,
                        'order': order_data
                    })
                else:
                    logger.warning(f"⚠️ Заказ #{order_id} уже существует или данные отсутствуют")
                    return jsonify({
                        'status': status,
                        'order_created': False,
                        'message': 'Заказ уже существует'
                    })

            elif status in ['REJECTED', 'DEADLINE_EXPIRED']:
                logger.warning(f"❌ Платёж #{order_id} отклонён. Заказ НЕ создан.")
                if order_id in payments:
                    del payments[order_id]
                return jsonify({
                    'status': status,
                    'order_created': False,
                    'message': f'Платёж отклонён: {status}'
                })

            return jsonify({'status': status})
        else:
            return jsonify({'status': 'error', 'message': result.get('Message')})

    except Exception as e:
        logger.error(f"❌ Ошибка: {e}")
        return jsonify({'status': 'error', 'message': str(e)})


@app.route('/api/payment/callback', methods=['POST'])
def payment_callback():
    try:
        data = request.json
        logger.info(f"📩 Получен callback: {data}")

        if data.get('Status') == 'CONFIRMED':
            order_id = int(data.get('OrderId'))
            logger.info(f"✅ Подтверждена оплата заказа #{order_id}")

            existing_order = next((o for o in orders if o['id'] == order_id), None)

            if not existing_order:
                payment = payments.get(order_id)
                if payment and payment.get('order_data'):
                    order_data = payment['order_data']
                    order_data['created_at'] = datetime.now().isoformat()
                    order_data['status'] = 'accepted'
                    order_data['payment_status'] = 'paid'

                    orders.append(order_data)
                    save_orders(orders)

                    if order_id in payments:
                        payments[order_id]['status'] = 'CONFIRMED'

                    logger.info(f"✅ ЗАКАЗ #{order_id} СОЗДАН через callback!")

                    # ===== ОТПРАВКА В TELEGRAM =====
                    send_telegram_order(order_data)

                    socketio.emit('order_status_update', {
                        'order_id': order_id,
                        'status': 'accepted'
                    })
                else:
                    logger.warning(f"⚠️ Данные заказа #{order_id} не найдены")
            else:
                logger.info(f"ℹ️ Заказ #{order_id} уже существует")

        elif data.get('Status') in ['REJECTED', 'DEADLINE_EXPIRED']:
            order_id = int(data.get('OrderId'))
            logger.warning(f"❌ Платёж #{order_id} отклонён. Заказ НЕ создан.")
            if order_id in payments:
                del payments[order_id]

        return jsonify({'code': 0, 'Message': 'OK'})

    except Exception as e:
        logger.error(f"❌ Ошибка callback: {e}")
        return jsonify({'code': 0, 'Message': 'OK'})


@app.route('/api/orders', methods=['POST'])
def create_order():
    global orders
    try:
        order_data = request.json
        payment = order_data.get('payment', 'cash')

        if payment == 'online':
            logger.info(f"ℹ️ Заказ #{order_data['id']} будет создан после подтверждения оплаты")
            return jsonify({
                'success': True,
                'message': 'Ожидайте подтверждения оплаты',
                'order_id': order_data['id'],
                'pending': True
            }), 202

        order_data['created_at'] = datetime.now().isoformat()
        order_data['status'] = order_data.get('status', 'new')
        order_data['payment_status'] = order_data.get('payment_status', 'pending')

        orders.append(order_data)
        save_orders(orders)

        logger.info(f"✅ Заказ #{order_data['id']} сохранён (оплата наличными)")
        logger.info(f"   Сумма: {order_data['total']} руб.")
        logger.info(f"   Клиент: {order_data['customer']['name']}")

        # ===== ОТПРАВКА В TELEGRAM ДЛЯ НАЛИЧНЫХ =====
        send_telegram_order(order_data)

        socketio.emit('new_order', order_data)

        return jsonify({'success': True, 'order': order_data}), 201

    except Exception as e:
        logger.error(f"❌ Ошибка создания заказа: {e}")
        return jsonify({'success': False, 'error': str(e)}), 400


