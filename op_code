ORDERS_FILE = 'orders.json'

def load_orders():
    try:
        if os.path.exists(ORDERS_FILE):
            with open(ORDERS_FILE, 'r', encoding='utf-8') as f:
                content = f.read().strip()
                if content:
                    data = json.loads(content)
                    if isinstance(data, list):
                        return data
        return []
    except Exception as e:
        logger.error(f"Ошибка загрузки заказов: {e}")
        return []


def save_orders(orders_data):
    try:
        with open(ORDERS_FILE, 'w', encoding='utf-8') as f:
            json.dump(orders_data, f, ensure_ascii=False, indent=2)
        return True
    except Exception as e:
        logger.error(f"Ошибка сохранения заказов: {e}")
        return False


orders = load_orders()
payments = {}


def generate_token(params):
    """
    Генерация токена ПО ДОКУМЕНТАЦИИ Т-БАНКА.
    Пароль добавляется после OrderId, но перед PayType.
    """
    filtered = {}
    for key, value in params.items():
        if key == 'Token':
            continue
        if key == 'DATA':
            continue
        if value is None or value == '':
            continue
        filtered[key] = str(value)

    correct_order = ['Amount', 'Description', 'FailURL', 'Language', 'NotificationURL', 'OrderId', 'PayType',
                     'SuccessURL', 'TerminalKey']

    token_parts = []
    for key in correct_order:
        if key == 'PayType':
            token_parts.append(TBANK_PASSWORD)
        if key in filtered:
            token_parts.append(filtered[key])

    token_string = ''.join(token_parts)

    logger.info(f"🔑 Ключи: {correct_order}")
    logger.info(f"🔑 Строка подписи: {token_string}")

    return hashlib.sha256(token_string.encode('utf-8')).hexdigest()


def send_telegram_order(order_data):
    """Отправка заказа в Telegram бот"""
    try:
        if not order_data:
            logger.error("❌ order_data пустой, не могу отправить в Telegram")
            return False

        url = f"https://api.telegram.org/bot{BOT_TOKEN}/sendMessage"

        # Формируем список товаров
        items_text = ""
        for item in order_data.get('items', []):
            name = item.get('name', 'Товар')
            quantity = item.get('quantity', 1)
            price = item.get('price', 0)
            total = price * quantity
            items_text += f"\n• {name} x{quantity} = {total} ₽"

        if not items_text:
            items_text = "\n• Состав не указан"

        # Статус заказа
        status_map = {
            'new': '🆕 Новый',
            'accepted': '✅ Принят',
            'cooking': '👨‍🍳 Готовится',
            'delivering': '🛵 В пути',
            'delivered': '🎉 Доставлен',
            'cancelled': '❌ Отменён'
        }
        status = status_map.get(order_data.get('status', 'new'), '🆕 Новый')

        message = f"""
🍕 <b>НОВЫЙ ЗАКАЗ #{order_data['id']}</b>
━━━━━━━━━━━━━━━━━━━━

👤 <b>Клиент:</b> {order_data.get('customer', {}).get('name', 'Не указан')}
📞 <b>Телефон:</b> {order_data.get('customer', {}).get('phone', 'Не указан')}
📍 <b>Адрес:</b> {order_data.get('customer', {}).get('address', 'Не указан')}
💬 <b>Комментарий:</b> {order_data.get('customer', {}).get('comment', 'Нет')}

━━━━━━━━━━━━━━━━━━━━
📋 <b>СОСТАВ:</b>
{items_text}
━━━━━━━━━━━━━━━━━━━━
💰 <b>Сумма:</b> {order_data.get('total', 0)} ₽
💳 <b>Оплата:</b> {order_data.get('payment', 'Не указано')}
📊 <b>Статус:</b> {status}

🕐 <b>Создан:</b> {order_data.get('created_at', datetime.now().strftime('%d.%m.%Y %H:%M:%S'))}
"""

        logger.info(f"📤 Отправка уведомления в Telegram...")
        logger.info(f"   Chat ID: {ADMIN_CHAT_ID}")
        logger.info(f"   Message length: {len(message)}")

        response = requests.post(
            url,
            json={
                'chat_id': ADMIN_CHAT_ID,
                'text': message,
                'parse_mode': 'HTML'
            },
            timeout=10
        )

        logger.info(f"📥 Telegram ответ: {response.status_code}")
        logger.info(f"📥 Telegram тело: {response.text}")

        if response.status_code == 200:
            logger.info(f"✅ Уведомление о заказе #{order_data['id']} отправлено в Telegram")
            return True
        else:
            logger.error(f"❌ Ошибка отправки в Telegram: {response.status_code} - {response.text}")
            return False

    except Exception as e:
        logger.error(f"❌ Ошибка отправки в Telegram: {e}")
        import traceback
        traceback.print_exc()
        return False


